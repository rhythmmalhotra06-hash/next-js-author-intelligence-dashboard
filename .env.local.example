# Airtable Personal Access Token (REQUIRED)
# Required scopes: data.records:read, schema.bases:read
# Create at: https://airtable.com/create/tokens
AIRTABLE_PAT=your_pat_here

# Groq API key (OPTIONAL — feeds AI enrichment for transcript / feedback analysis)
# Without this, AI-derived signals fall back to mock values; the app still runs.
# The OpenAI SDK is used as a client but pointed at Groq's OpenAI-compatible endpoint.
# Create at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
